# Copie este arquivo para .env e substitua todos os valores CHANGE_ME.
# Gere senhas aleatórias fortes; não reutilize credenciais.

POSTGRES_USER=allwhatspy
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=allwhatspy_db
# No Docker Swarm, use o nome completo do serviço para evitar colisões de DNS.
# Codifique na senha os caracteres reservados de URL (por exemplo: @ = %40,
# # = %23, / = %2F).
DATABASE_URL="postgresql://allwhatspy:CHANGE_ME_URL_ENCODED_DATABASE_PASSWORD@allwhatspy_postgres:5432/allwhatspy_db?schema=public"

ADMIN_INITIAL_EMAIL=admin@allwhatspy.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_RANDOM_ADMIN_PASSWORD
SECRET_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# Listas separadas por vírgula. Quando preenchidas, somente esses hosts serão aceitos.
EVOLUTION_ALLOWED_HOSTS=api.seu-dominio.com
EVOLUTION_API_URL=https://api.seu-dominio.com
EVOLUTION_API_KEY=CHANGE_ME_EVOLUTION_API_KEY
EVOLUTION_INSTANCE_NAME=allwhatspy
WEBHOOK_ALLOWED_HOSTS=hooks.seu-dominio.com
SMTP_ALLOWED_HOSTS=smtp.seu-provedor.com
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@seu-dominio.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_NAME=AllWhatsPy
SMTP_FROM_EMAIL=usuario@seu-dominio.com

PORT=3000
NODE_ENV=production
