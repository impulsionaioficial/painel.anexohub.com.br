# ==========================================
# AllWhatsPy Web - Environment Variables
# ==========================================

# 1. PostgreSQL Database URL Connection String
# Para execução no Docker Compose (mesma rede traefik-net):
DATABASE_URL="postgresql://allwhatspy:allwhatspy_secret_pass@postgres:5432/allwhatspy_db?schema=public"

# Para conexão local durante desenvolvimento:
# DATABASE_URL="postgresql://allwhatspy:allwhatspy_secret_pass@localhost:5432/allwhatspy_db?schema=public"

# 2. Server Configuration
PORT=3000
NODE_ENV=production

# 3. Evolution API (Opcional - pode ser configurado via painel em VPS Config)
# NEXT_PUBLIC_EVOLUTION_API_URL=https://api.sua-vps.com
# NEXT_PUBLIC_EVOLUTION_API_KEY=SUA_GLOBAL_API_KEY
